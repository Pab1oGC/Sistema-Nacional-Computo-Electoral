# ============================================================
# backend/.env.example — variables del API FastAPI.
# Copialo a backend/.env para correr el backend en local
# (sin Docker). En Docker, las env vars vienen del compose.
#
# Para variables consumidas por docker-compose (passwords,
# n8n auth) ver oficial/.env.example.
# ============================================================

# Conexión a la BD master (escritura). Hostname `oficial_master`
# resuelve dentro de la red rrv-net; para correr localmente fuera
# de Docker, cambialo a localhost o 127.0.0.1.
DB_URL=postgresql+asyncpg://oficial_writer:oficial_2025@oficial_master:5432/oficial

# Conexión a la réplica (solo lectura). Opcional; si está seteado,
# el dashboard general puede leer de la réplica.
DB_URL_REPLICA=postgresql+asyncpg://dashboard_ro:dash_2025@oficial_replica:5432/oficial

# BD de test para tests de integración. Si no está seteado, los
# tests `@requires_db` se saltean (ver tests/conftest.py).
DB_URL_TEST=

LOG_LEVEL=INFO
