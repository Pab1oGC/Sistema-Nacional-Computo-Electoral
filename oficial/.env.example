# ============================================================
# .env.example — variables que docker-compose.oficial.yml lee.
# Copialo a .env y editá los valores. .env NUNCA va a git.
# ============================================================

# ─── Passwords del cluster PostgreSQL ───────────────────────
# Estos defaults matchean los hardcoded en sql/01-schema.sql.
# Cambialos antes de producción y actualizá 01-schema.sql en paralelo
# (o reemplazá el bloque DO $$ ... CREATE ROLE ... $$ por un init
# script que lea estos env vars).

OFICIAL_DB_PASSWORD=oficial_2025
REPLICATION_PASSWORD=replica_2025
DASHBOARD_RO_PASSWORD=dash_2025

# ─── n8n ────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=admin_2025

# ─── API ────────────────────────────────────────────────────
LOG_LEVEL=INFO
